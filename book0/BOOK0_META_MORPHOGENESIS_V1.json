  "memory_classes": ["M+", "M-", "M?"],
  "promotion_contract": {
    "requires_independent_verification": true,
    "requires_evidence": true,
    "requires_tests": true,
    "requires_complexity_rent": true,
    "auto_promotion": false,
    "external_action_performed": false
  },
  "regeneration_levels": [
    "R0 artifact",
    "R1 component",
    "R2 system",
    "R3 capability",
    "R4 compiler",
    "R5 ecology",
    "R6 constitution-aware",
    "R7 minimal seed candidate"
  ],
  "apoptosis_contract": {
    "automatic_delete": false,
    "requires_full_regeneration_closure": true,
    "requires_evidence_preservation": true,
    "requires_provenance_preservation": true,
    "disposition": "ELIGIBLE_FOR_REVIEW"
  },
  "regeneration_order": [
    "load canonical omega_morphogenesis kernel",
    "load TristanIR and hard gates",
    "load MorphGenome contract",
    "run invariant mutation probes",
    "run meta compiler tests",
    "run meta morphogenesis tests",
    "emit candidate capability crystals only after gates pass"
  ]

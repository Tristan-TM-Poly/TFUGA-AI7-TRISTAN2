{
  "name": "BOOK0_META_MORPHOGENESIS_V1",
  "status": "CANDIDATE",
  "purpose": "Minimal seed for proof-carrying meta-generation, regeneration, improvement, apoptosis and crystallization.",
  "kernel_reuse": [
    "omega_morphogenesis.MorphogenesisKernel",
    "omega_morphogenesis.ProofCarryingTransformation",
    "omega_morphogenesis.TransformationMetrics",
    "omega_morphogenesis.CapabilityCrystal"
  ],
  "required_components": [
    "omega_tristan_meta/models.py",
    "omega_tristan_meta/gates.py",
    "omega_tristan_meta/morphogenesis.py",
    "schemas/morph_genome.schema.json",
    "tests/test_meta_compiler.py",
    "tests/test_meta_morphogenesis.py"
  ],
  "invariants": [
    "Generated != Verified",
    "Simulation != Reality",
    "Generator != Judge",
    "Capability != Authority",
    "MetaGeneration != Progress",
    "SelfModification != SelfApproval",
    "Crystal != EternalTruth",
    "Apoptosis != AutomaticDeletion",
    "FORGET+ != DestructiveForget",
    "PersistentStructure <= VerifiedNecessaryStructure"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/omega-university/learning-observation-r0.3.schema.json",
  "title": "Omega University Learning Observation R0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_id",
    "intervention_id",
    "capability_id",
    "assessment_digest",
    "pre_score",
    "post_score",
    "context"
  ],
  "properties": {
    "observation_id": {"type": "string", "minLength": 1},
    "intervention_id": {"type": "string", "minLength": 1},
    "capability_id": {"type": "string", "minLength": 1},
    "assessment_digest": {"type": "string", "minLength": 1},
    "pre_score": {"type": "number", "minimum": 0, "maximum": 1},
    "post_score": {"type": "number", "minimum": 0, "maximum": 1},
    "context": {"type": "string", "minLength": 1},
    "randomized_assignment": {"type": "boolean", "default": false},
    "concurrent_control": {"type": "boolean", "default": false},
    "independent_evaluator": {"type": "boolean", "default": false}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/omega-compute/evidence-v0.7.schema.json",
  "title": "Omega Optimization Foundry Evidence v0.7",
  "type": "object",
  "required": ["kind", "status"],
  "properties": {
    "kind": {
      "enum": [
        "optimization-opportunity",
        "optimization-transformation",
        "optimization-transformation-program",
        "optimization-arena",
        "optimization-gene",
        "optimization-transfer-candidate",
        "optimization-credit-attribution",
        "bottleneck-dynamics",
        "optimization-portfolio"
      ]
    },
    "status": {"type": "string"},
    "repository": {"type": "string"},
    "commit_sha": {"type": "string", "minLength": 7},
    "oak_warning": {"type": "string"},
    "payload": {"type": "object"}
  },
  "additionalProperties": true,
  "description": "R0.7 planning/measured optimization evidence. Schema validity does not imply bottleneck causality, semantic preservation, speedup, portability, asymptotic improvement, or realized ROI."
}

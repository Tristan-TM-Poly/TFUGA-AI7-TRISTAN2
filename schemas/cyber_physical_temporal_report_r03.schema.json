{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tristan.invalid/schemas/cyber_physical_temporal_report_r03.schema.json",
  "title": "Omega CPS R0.3 Temporal Verification Report",
  "type": "object",
  "required": [
    "trace_hash",
    "results",
    "passed",
    "property_count",
    "passed_count",
    "violation_count",
    "evidence_hash",
    "formal_proof",
    "safety_certified",
    "limitations"
  ],
  "properties": {
    "trace_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "property",
          "passed",
          "evaluation_count",
          "trigger_count",
          "satisfaction_count",
          "violation_count",
          "first_satisfaction",
          "first_violation",
          "detail"
        ],
        "properties": {
          "property": {
            "type": "object",
            "required": ["property_id", "kind", "description", "within_s", "mode_sequence", "start_s", "end_s"],
            "properties": {
              "property_id": {"type": "string", "minLength": 1},
              "kind": {"enum": ["ALWAYS", "EVENTUALLY", "RESPONSE", "MODE_SEQUENCE"]},
              "description": {"type": "string", "minLength": 1},
              "predicate": {"type": ["object", "null"]},
              "target_mode": {"type": ["string", "null"]},
              "trigger": {"type": ["object", "null"]},
              "trigger_mode": {"type": ["string", "null"]},
              "response": {"type": ["object", "null"]},
              "response_mode": {"type": ["string", "null"]},
              "within_s": {"type": ["number", "null"], "minimum": 0},
              "mode_sequence": {"type": "array", "items": {"type": "string"}},
              "start_s": {"type": "number", "minimum": 0},
              "end_s": {"type": ["number", "null"], "minimum": 0}
            }
          },
          "passed": {"type": "boolean"},
          "evaluation_count": {"type": "integer", "minimum": 0},
          "trigger_count": {"type": "integer", "minimum": 0},
          "satisfaction_count": {"type": "integer", "minimum": 0},
          "violation_count": {"type": "integer", "minimum": 0},
          "first_satisfaction": {"type": ["object", "null"]},
          "first_violation": {"type": ["object", "null"]},
          "detail": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "passed": {"type": "boolean"},
    "property_count": {"type": "integer", "minimum": 1},
    "passed_count": {"type": "integer", "minimum": 0},
    "violation_count": {"type": "integer", "minimum": 0},
    "evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "formal_proof": {"const": false},
    "safety_certified": {"const": false},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/omega_rigid_body_r02_oak.schema.json",
  "title": "Omega Rigid Body R0.2 OAK report",
  "type": "object",
  "required": [
    "status",
    "passed",
    "results",
    "certified_analytic_identities",
    "certified_computational_fixtures",
    "certified_physics",
    "experimental_validation",
    "new_law_of_physics_claimed"
  ],
  "properties": {
    "status": {"type": "string"},
    "passed": {"type": "boolean"},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["benchmark_id", "passed", "metric", "threshold", "details"],
        "properties": {
          "benchmark_id": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "metric": {"type": "number"},
          "threshold": {"type": "number"},
          "details": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "certified_analytic_identities": {"type": "boolean"},
    "certified_computational_fixtures": {"type": "boolean"},
    "certified_physics": {"const": false},
    "experimental_validation": {"const": false},
    "new_law_of_physics_claimed": {"const": false}
  },
  "additionalProperties": false
}

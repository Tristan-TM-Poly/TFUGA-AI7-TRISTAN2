{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/omega_histosci_branch_v1.schema.json",
  "title": "Ω-HISTOSCI-HG-T∞ branch record R0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["branch_id", "canonical_name", "parent_branch_ids", "origin_problems"],
  "properties": {
    "branch_id": {"type": "string", "minLength": 1, "pattern": "^[^\\s]+$"},
    "canonical_name": {"type": "string", "minLength": 1},
    "parent_branch_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "origin_problems": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "precursor_node_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "key_concept_node_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "instrument_node_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "method_node_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "split_branch_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "merged_branch_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "negative_memory_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "open_problems": {"type": "array", "items": {"type": "string"}},
    "established_core": {"type": "array", "items": {"type": "string"}},
    "active_research": {"type": "array", "items": {"type": "string"}},
    "speculative_extensions": {"type": "array", "items": {"type": "string"}},
    "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tristan-TM-Poly/TFUGA-AI7-TRISTAN2/schemas/omega_unbounded_addition.schema.json",
  "title": "Omega Unbounded Logical Addition",
  "description": "One provenance-aware logical addition for the Ω-SANS-PLAFOND-T streaming GitHub planner. This schema places no ceiling on the total number of records in a stream.",
  "type": "object",
  "properties": {
    "addition_id": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "namespace": {
      "type": "string",
      "minLength": 1,
      "default": "general"
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "default": "addition"
    },
    "payload": {
      "type": "object"
    },
    "provenance": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      ]
    },
    "risk": {
      "type": "string",
      "default": "normal"
    },
    "metadata": {
      "type": "object",
      "default": {}
    }
  },
  "anyOf": [
    {"required": ["payload"]},
    {
      "description": "When payload is omitted, non-control fields are compiled as the payload by the R0.2 parser."
    }
  ],
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tristan.invalid/schemas/omega_problem_routing_report_v8.schema.json",
  "title": "Omega Problem Routing Report V8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "ledger_id",
    "cell_count",
    "event_count",
    "front_count",
    "problem_count",
    "selected_count",
    "front_coverage",
    "problem_coverage",
    "mminus_record_count",
    "counterfactual_count",
    "selection_change_count",
    "event_rule_count",
    "final_event_hash",
    "event_rule_digest",
    "routing_score_is_truth_probability",
    "mathematical_truth_probability_claimed",
    "proof_claimed",
    "solution_claimed",
    "scientific_validation_claimed",
    "permanent_total_cap",
    "manifest_digest",
    "digest"
  ],
  "properties": {
    "schema": {"const": "omega-problem-routing-report/8"},
    "status": {"const": "CERTIFIED_EVIDENCE_ROUTING_FIXTURE_R0_8"},
    "ledger_id": {"type": "string", "minLength": 1},
    "cell_count": {"type": "integer", "minimum": 0},
    "event_count": {"type": "integer", "minimum": 0},
    "front_count": {"type": "integer", "minimum": 0},
    "problem_count": {"type": "integer", "minimum": 0},
    "selected_count": {"type": "integer", "minimum": 0},
    "front_coverage": {"type": "integer", "minimum": 0},
    "problem_coverage": {"type": "integer", "minimum": 0},
    "mminus_record_count": {"type": "integer", "minimum": 0},
    "counterfactual_count": {"type": "integer", "minimum": 0},
    "selection_change_count": {"type": "integer", "minimum": 0},
    "event_rule_count": {"type": "integer", "minimum": 1},
    "final_event_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "event_rule_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "routing_score_is_truth_probability": {"const": false},
    "mathematical_truth_probability_claimed": {"const": false},
    "proof_claimed": {"const": false},
    "solution_claimed": {"const": false},
    "scientific_validation_claimed": {"const": false},
    "permanent_total_cap": {"type": "null"},
    "manifest_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}

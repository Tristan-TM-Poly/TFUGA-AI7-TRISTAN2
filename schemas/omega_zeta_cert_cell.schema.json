{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/omega_zeta_cert_cell.schema.json",
  "title": "Omega Zeta Certificate Problem Cell",
  "type": "object",
  "required": ["cell_id", "problem_id", "target_id", "front", "method", "priority", "source_ref", "payload"],
  "additionalProperties": false,
  "properties": {
    "cell_id": {"type": "string", "pattern": "^zeta-cert-[0-9a-f]{20}$"},
    "problem_id": {"const": "riemann-hypothesis"},
    "target_id": {"type": "string", "minLength": 1},
    "front": {"enum": ["barrier", "representation", "research-route", "m-minus"]},
    "method": {"type": "string", "minLength": 1},
    "priority": {"type": "integer"},
    "source_ref": {"type": "string", "minLength": 1},
    "payload": {"type": "object"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tristan-tm-poly.example/schemas/omega_space_r04_oak_report_v1.schema.json",
  "title": "Omega Space HG R0.4 OAK report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "suite",
    "passed",
    "checks",
    "theorem_claimed",
    "scientific_validation_claimed",
    "flight_qualified_claimed",
    "operational_reliability_claimed",
    "safety_certification_claimed",
    "autonomous_safety_claimed",
    "limitations"
  ],
  "properties": {
    "suite": {"const": "OMEGA-SPACE-HG-T-R0.4-OAKBench"},
    "passed": {"type": "boolean"},
    "checks": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "passed", "observed", "criterion"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "observed": {},
          "criterion": {"type": "string", "minLength": 1}
        }
      }
    },
    "theorem_claimed": {"const": false},
    "scientific_validation_claimed": {"const": false},
    "flight_qualified_claimed": {"const": false},
    "operational_reliability_claimed": {"const": false},
    "safety_certification_claimed": {"const": false},
    "autonomous_safety_claimed": {"const": false},
    "limitations": {
      "type": "array",
      "minItems": 6,
      "items": {"type": "string", "minLength": 1}
    }
  }
}

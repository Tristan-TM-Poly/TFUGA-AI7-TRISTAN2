{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/omega_naruto_frontier_validation.schema.json",
  "title": "Omega Naruto Frontier Validation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "valid",
    "manifest_records",
    "observed_records",
    "observed_shards",
    "unique_record_ids",
    "findings",
    "non_claim"
  ],
  "properties": {
    "schema": {"const": "omega_naruto_frontier.validation.v1"},
    "valid": {"type": "boolean"},
    "manifest_records": {"type": "integer", "minimum": 0},
    "observed_records": {"type": "integer", "minimum": 0},
    "observed_shards": {"type": "integer", "minimum": 0},
    "unique_record_ids": {"type": "integer", "minimum": 0},
    "non_claim": {"type": "string", "minLength": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message", "path", "line_number"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "severity": {"enum": ["P0", "P1", "P2"]},
          "message": {"type": "string", "minLength": 1},
          "path": {"type": ["string", "null"]},
          "line_number": {"type": ["integer", "null"], "minimum": 1}
        }
      }
    }
  }
}

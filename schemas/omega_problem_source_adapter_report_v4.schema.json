{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tristan-TM-Poly/TFUGA-AI7-TRISTAN2/schemas/omega_problem_source_adapter_report_v4.schema.json",
  "title": "Omega Problem Atlas R0.4 source adapter report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "snapshot_count",
    "source_count",
    "input_record_count",
    "accepted_import_count",
    "status_receipt_count",
    "quarantine_count",
    "current_open_claim_count",
    "solution_claim_count",
    "records_requiring_refresh",
    "source_retrieval_certified",
    "current_status_certification_claimed",
    "scientific_validation_claimed",
    "solution_claimed",
    "formal_proof_claimed",
    "permanent_total_cap",
    "manifest_digest",
    "digest"
  ],
  "properties": {
    "schema": {"const": "omega-problem-source-adapter-report/4"},
    "status": {"const": "CERTIFIED_OFFLINE_SOURCE_ADAPTER_FIXTURE_R0_4"},
    "snapshot_count": {"type": "integer", "minimum": 0},
    "source_count": {"type": "integer", "minimum": 0},
    "input_record_count": {"type": "integer", "minimum": 0},
    "accepted_import_count": {"type": "integer", "minimum": 0},
    "status_receipt_count": {"type": "integer", "minimum": 0},
    "quarantine_count": {"type": "integer", "minimum": 0},
    "current_open_claim_count": {"type": "integer", "minimum": 0},
    "solution_claim_count": {"const": 0},
    "records_requiring_refresh": {"type": "integer", "minimum": 0},
    "source_retrieval_certified": {"const": false},
    "current_status_certification_claimed": {"const": false},
    "scientific_validation_claimed": {"const": false},
    "solution_claimed": {"const": false},
    "formal_proof_claimed": {"const": false},
    "permanent_total_cap": {"type": "null"},
    "manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

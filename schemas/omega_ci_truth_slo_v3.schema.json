{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"omega-ci-truth-slo/v3",
  "type":"object",
  "required":["schema","report_id","evaluations","metrics","passed","critical_failures","human_review_required"],
  "properties":{
    "schema":{"const":"omega-ci-truth-slo/v3"},
    "report_id":{"type":"string","pattern":"^TRUTHSLO-"},
    "evaluations":{"type":"array"},
    "metrics":{"type":"object"},
    "passed":{"type":"boolean"},
    "critical_failures":{"type":"integer","minimum":0},
    "human_review_required":{"const":true}
  }
}

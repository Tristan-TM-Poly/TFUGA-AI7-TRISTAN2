{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tristan-tm-poly.example/schemas/cyber_physical_cosim_report_r01.schema.json",
  "title": "Omega Cyber Physical Closed Loop Co-Simulation Report R0.1",
  "type": "object",
  "required": [
    "scenario",
    "plant",
    "electronics",
    "safety",
    "controller",
    "samples",
    "sample_count",
    "final_position_m",
    "final_error_m",
    "rms_error_m",
    "overshoot_fraction",
    "settling_time_s",
    "peak_current_a",
    "peak_temperature_k",
    "peak_velocity_mps",
    "net_electrical_energy_j",
    "absolute_electrical_energy_j",
    "positive_mechanical_energy_j",
    "deadline_miss_count",
    "saturation_count",
    "shutdown_reasons",
    "finite",
    "evidence_hash",
    "physics_certified",
    "software_certified",
    "hardware_validated",
    "limitations"
  ],
  "properties": {
    "scenario": {
      "type": "object",
      "required": [
        "scenario_id",
        "duration_s",
        "integration_step_s",
        "setpoint_m",
        "external_force_n",
        "faults"
      ]
    },
    "plant": {"type": "object"},
    "electronics": {"type": "object"},
    "safety": {"type": "object"},
    "controller": {"type": "object"},
    "samples": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "time_s",
          "setpoint_m",
          "true_position_m",
          "measured_position_m",
          "velocity_mps",
          "current_a",
          "motor_temperature_k",
          "voltage_command_v",
          "tracking_error_m",
          "electrical_power_w",
          "mechanical_power_w",
          "deadline_missed",
          "shutdown_latched"
        ],
        "properties": {
          "time_s": {"type": "number", "minimum": 0},
          "setpoint_m": {"type": "number"},
          "true_position_m": {"type": "number"},
          "measured_position_m": {"type": "number"},
          "velocity_mps": {"type": "number"},
          "current_a": {"type": "number"},
          "motor_temperature_k": {"type": "number", "exclusiveMinimum": 0},
          "voltage_command_v": {"type": "number"},
          "tracking_error_m": {"type": "number"},
          "electrical_power_w": {"type": "number"},
          "mechanical_power_w": {"type": "number"},
          "deadline_missed": {"type": "boolean"},
          "shutdown_latched": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "sample_count": {"type": "integer", "minimum": 2},
    "final_position_m": {"type": "number"},
    "final_error_m": {"type": "number"},
    "rms_error_m": {"type": "number", "minimum": 0},
    "overshoot_fraction": {"type": "number", "minimum": 0},
    "settling_time_s": {"type": ["number", "null"], "minimum": 0},
    "peak_current_a": {"type": "number", "minimum": 0},
    "peak_temperature_k": {"type": "number", "exclusiveMinimum": 0},
    "peak_velocity_mps": {"type": "number", "minimum": 0},
    "net_electrical_energy_j": {"type": "number"},
    "absolute_electrical_energy_j": {"type": "number", "minimum": 0},
    "positive_mechanical_energy_j": {"type": "number", "minimum": 0},
    "deadline_miss_count": {"type": "integer", "minimum": 0},
    "saturation_count": {"type": "integer", "minimum": 0},
    "shutdown_reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "finite": {"const": true},
    "evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "physics_certified": {"const": false},
    "software_certified": {"const": false},
    "hardware_validated": {"const": false},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/omega-hqt/decision-package-v1.schema.json",
  "title": "Omega HQT Decision Package v1",
  "type": "object",
  "required": [
    "package_id",
    "mission",
    "votes",
    "claims",
    "status",
    "evidence_hash"
  ],
  "properties": {
    "package_id": {"type": "string"},
    "mission": {"type": "string"},
    "recommended_interventions": {"type": "array", "items": {"type": "string"}},
    "votes": {"type": "array", "minItems": 1},
    "claims": {"type": "object"},
    "status": {"type": "string"},
    "evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}

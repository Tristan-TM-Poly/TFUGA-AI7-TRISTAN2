{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tristan.invalid/schemas/animatic-timeline-r2.schema.json",
  "title": "Omega Anime Animatic Timeline R2",
  "type": "object",
  "required": [
    "project_id",
    "title",
    "version",
    "duration_s",
    "fps_reference",
    "publication_state",
    "scenes",
    "shots",
    "disclaimers"
  ],
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "version": {"const": "omega-anime-animatic/r2"},
    "duration_s": {"const": 180.0},
    "fps_reference": {"type": "integer", "minimum": 1},
    "publication_state": {"const": "private-draft"},
    "scenes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "scene_id",
          "title",
          "order",
          "start_s",
          "end_s",
          "duration_s",
          "objective",
          "irreversible_change"
        ],
        "properties": {
          "scene_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "order": {"type": "integer", "minimum": 1},
          "start_s": {"type": "number", "minimum": 0},
          "end_s": {"type": "number", "exclusiveMinimum": 0},
          "duration_s": {"type": "number", "exclusiveMinimum": 0},
          "objective": {"type": "string", "minLength": 1},
          "irreversible_change": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "shots": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "shot_id",
          "scene_id",
          "order",
          "start_s",
          "end_s",
          "duration_s",
          "purpose",
          "framing",
          "camera_motion",
          "subjects",
          "caption",
          "dialogue",
          "audio_cue",
          "intensity"
        ],
        "properties": {
          "shot_id": {"type": "string", "minLength": 1},
          "scene_id": {"type": "string", "minLength": 1},
          "order": {"type": "integer", "minimum": 1},
          "start_s": {"type": "number", "minimum": 0},
          "end_s": {"type": "number", "exclusiveMinimum": 0},
          "duration_s": {"type": "number", "exclusiveMinimum": 0},
          "purpose": {"type": "string", "minLength": 1},
          "framing": {"type": "string", "minLength": 1},
          "camera_motion": {"type": "string", "minLength": 1},
          "subjects": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "caption": {"type": "string", "minLength": 1},
          "dialogue": {"type": "string"},
          "audio_cue": {"type": "string", "minLength": 1},
          "intensity": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "disclaimers": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tristan.invalid/schemas/omega_ci_claim_coverage_v2.schema.json",
  "type": "object",
  "required": ["schema", "report_id", "claims", "weighted_score", "covered_claims", "blocked_claims", "uncovered_claims"],
  "properties": {
    "schema": {"const": "omega-ci-claim-coverage/v2"},
    "report_id": {"type": "string", "pattern": "^COVERAGE-[A-F0-9]{20}$"},
    "weighted_score": {"type": "number", "minimum": 0, "maximum": 1},
    "covered_claims": {"type": "integer", "minimum": 0},
    "blocked_claims": {"type": "integer", "minimum": 0},
    "uncovered_claims": {"type": "integer", "minimum": 0},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "required_kinds", "observed_kinds", "missing_kinds", "dimensions", "score", "weight", "blocked", "reasons"],
        "properties": {
          "claim_id": {"type": "string"},
          "required_kinds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "observed_kinds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "missing_kinds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "dimensions": {"type": "object", "additionalProperties": {"type": "boolean"}},
          "score": {"type": "number", "minimum": 0, "maximum": 1},
          "weight": {"type": "number", "exclusiveMinimum": 0},
          "blocked": {"type": "boolean"},
          "reasons": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.invalid/schemas/omega_asm_superopt.schema.json",
  "title":"Omega ASM-T bounded proof-first superoptimization report",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","evidence_level","name","width","variables","claim_scope","authority","cost_model","search_bounds","original","best","improved_structural_cost","candidates","selection_contract"],
  "properties":{
    "schema_version":{"const":1},
    "evidence_level":{"const":"bounded-proof-first-superoptimization"},
    "name":{"type":"string","minLength":1},
    "width":{"type":"integer","minimum":1,"maximum":64},
    "variables":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "claim_scope":{"const":"fixed_width_bitvector_structural_optimization_only"},
    "authority":{"const":"review_only"},
    "cost_model":{"type":"object","required":["id","calibrated","units","runtime_cycles"],"properties":{"id":{"const":"omega-asm-superopt-structural-v1"},"calibrated":{"const":false},"units":{"const":"structural_cost_units"},"runtime_cycles":{"const":false}}},
    "search_bounds":{"type":"object","required":["max_candidates","max_states_per_proof","candidate_count","accepted_equivalent_count"],"properties":{"max_candidates":{"type":"integer","minimum":1},"max_states_per_proof":{"type":"integer","minimum":1},"candidate_count":{"type":"integer","minimum":1},"accepted_equivalent_count":{"type":"integer","minimum":1}}},
    "original":{"type":"object","required":["expression","structural_cost_units"],"properties":{"expression":{"type":"object"},"structural_cost_units":{"type":"number","minimum":0}}},
    "best":{"$ref":"#/$defs/candidate"},
    "improved_structural_cost":{"type":"boolean"},
    "candidates":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/candidate"}},
    "selection_contract":{"type":"object","required":["equivalence_before_selection","unverified_candidate_can_win","runtime_speed_claim_allowed","automatic_authority_promotion"],"properties":{"equivalence_before_selection":{"const":true},"unverified_candidate_can_win":{"const":false},"runtime_speed_claim_allowed":{"const":false},"automatic_authority_promotion":{"const":false}}}
  },
  "$defs":{
    "candidate":{"type":"object","required":["expression","trace","structural_cost_units","cost_delta_from_original","proof"],"properties":{"expression":{"type":"object"},"trace":{"type":"array","items":{"type":"string"}},"structural_cost_units":{"type":"number","minimum":0},"cost_delta_from_original":{"type":"number"},"proof":{"type":"object","required":["obligation_id","verification_status","accepted_equivalent","kernel_checked","states_total","states_checked","counterexample"],"properties":{"obligation_id":{"type":["string","null"]},"verification_status":{"type":"string"},"accepted_equivalent":{"type":"boolean"},"kernel_checked":{"const":false},"states_total":{"type":["integer","null"]},"states_checked":{"type":["integer","null"]},"counterexample":{"type":["object","null"]}}}}}
  }
}

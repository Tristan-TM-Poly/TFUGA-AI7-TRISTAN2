{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tristan.local/schemas/omega_ci_causal_diagnosis_v4.schema.json",
  "title": "Omega CI causal diagnosis v4",
  "type": "object",
  "required": ["schema", "diagnosis_id", "failure_id", "assessments", "status", "causality_proven", "human_review_required", "automatic_patch_allowed", "remote_mutations"],
  "properties": {
    "schema": {"const": "omega-ci-causal-diagnosis/v4"},
    "diagnosis_id": {"type": "string", "pattern": "^DIAG-[A-F0-9]{20}$"},
    "failure_id": {"type": "string"},
    "assessments": {"type": "array", "minItems": 1},
    "status": {"enum": ["AMBIGUOUS", "HEURISTICALLY_SUPPORTED", "INSUFFICIENT_EVIDENCE", "ALL_HYPOTHESES_REFUTED"]},
    "top_hypothesis_id": {"type": ["string", "null"]},
    "support_gap": {"type": "number", "minimum": 0, "maximum": 1},
    "prior_entropy": {"type": "number", "minimum": 0},
    "posterior_entropy": {"type": "number", "minimum": 0},
    "information_gain": {"type": "number", "minimum": 0},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "causality_proven": {"const": false},
    "human_review_required": {"const": true},
    "automatic_patch_allowed": {"const": false},
    "remote_mutations": {"const": 0}
  },
  "additionalProperties": false
}

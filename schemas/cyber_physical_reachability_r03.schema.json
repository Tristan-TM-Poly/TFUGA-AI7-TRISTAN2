{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tristan.invalid/schemas/cyber_physical_reachability_r03.schema.json",
  "title": "Omega CPS R0.3 Bounded Reachability Report",
  "type": "object",
  "required": [
    "automaton_hash",
    "integration_step_s",
    "steps_requested",
    "steps_completed",
    "nodes",
    "frontier_node_ids",
    "node_count",
    "transition_branch_count",
    "invariant_pruned_count",
    "uncertain_invariant_count",
    "unsafe_possible_count",
    "unsafe_definite_count",
    "truncated",
    "execution_node_budget",
    "permanent_total_cap",
    "evidence_hash",
    "formal_reachability_proven",
    "safety_certified",
    "limitations"
  ],
  "properties": {
    "automaton_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "integration_step_s": {"type": "number", "exclusiveMinimum": 0},
    "steps_requested": {"type": "integer", "minimum": 1},
    "steps_completed": {"type": "integer", "minimum": 0},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "node_id",
          "step",
          "time_s",
          "mode_id",
          "box",
          "parent_id",
          "transition_id",
          "invariant_definite",
          "unsafe_possible",
          "unsafe_definite"
        ],
        "properties": {
          "node_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
          "step": {"type": "integer", "minimum": 0},
          "time_s": {"type": "number", "minimum": 0},
          "mode_id": {"type": "string", "minLength": 1},
          "box": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["lower", "upper"],
              "properties": {
                "lower": {"type": "number"},
                "upper": {"type": "number"}
              },
              "additionalProperties": false
            }
          },
          "parent_id": {"type": ["string", "null"]},
          "transition_id": {"type": ["string", "null"]},
          "invariant_definite": {"type": "boolean"},
          "unsafe_possible": {"type": "boolean"},
          "unsafe_definite": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "frontier_node_ids": {"type": "array", "items": {"type": "string"}},
    "node_count": {"type": "integer", "minimum": 1},
    "transition_branch_count": {"type": "integer", "minimum": 0},
    "invariant_pruned_count": {"type": "integer", "minimum": 0},
    "uncertain_invariant_count": {"type": "integer", "minimum": 0},
    "unsafe_possible_count": {"type": "integer", "minimum": 0},
    "unsafe_definite_count": {"type": "integer", "minimum": 0},
    "truncated": {"type": "boolean"},
    "execution_node_budget": {"type": "integer", "minimum": 1},
    "permanent_total_cap": {"type": "null"},
    "evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "formal_reachability_proven": {"const": false},
    "safety_certified": {"const": false},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}

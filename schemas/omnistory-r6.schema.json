{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tristan.invalid/schemas/omnistory-r6.schema.json",
  "title": "Ω-OMNISTORY-T∞ R6 StoryIR",
  "type": "object",
  "additionalProperties": false,
  "required": ["story_id", "title", "premise", "theme_question", "world_rules", "characters", "events", "canon", "presentation_backends", "metadata"],
  "properties": {
    "story_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "premise": {"type": "string", "minLength": 20},
    "theme_question": {"type": "string", "pattern": "\\?$"},
    "world_rules": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["character_id", "name", "goals", "fears", "knowledge", "abilities", "constraints", "voice_rules"],
        "properties": {
          "character_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "goals": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "fears": {"type": "array", "items": {"type": "string"}},
          "knowledge": {"type": "array", "items": {"type": "string"}},
          "abilities": {"type": "array", "items": {"type": "string"}},
          "constraints": {"type": "array", "items": {"type": "string"}},
          "voice_rules": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "summary", "causes", "actors", "consequences", "irreversible"],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "causes": {"type": "array", "items": {"type": "string"}},
          "actors": {"type": "array", "items": {"type": "string"}},
          "consequences": {"type": "array", "items": {"type": "string"}},
          "irreversible": {"type": "boolean"}
        }
      }
    },
    "canon": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "statement", "status", "provenance", "supersedes"],
        "properties": {
          "fact_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "status": {"enum": ["DRAFT", "POSSIBLE", "CANON", "RETCON", "DEPRECATED", "CONTRADICTED"]},
          "provenance": {"type": "array", "items": {"type": "string"}},
          "supersedes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "residuals": {"type": "array"},
    "presentation_backends": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "metadata": {"type": "object"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tristan-tm-poly.github.io/schemas/omega_vla_ir_v1.schema.json",
  "title": "Omega VLA Intermediate Representation v1",
  "type": "object",
  "required": [
    "schema",
    "program_id",
    "title",
    "version",
    "nodes",
    "edges",
    "metadata",
    "claim_boundaries"
  ],
  "properties": {
    "schema": {"const": "omega-vla-ir-v1"},
    "program_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "metadata": {"type": "object"},
    "nodes": {
      "type": "array",
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/$defs/edge"}
    },
    "claim_boundaries": {
      "type": "object",
      "required": [
        "theorem_claimed",
        "formal_proof_claimed",
        "scientific_validation_claimed"
      ],
      "properties": {
        "theorem_claimed": {"const": false},
        "formal_proof_claimed": {"const": false},
        "scientific_validation_claimed": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "mathType": {
      "type": "object",
      "required": [
        "structure",
        "scalar_system",
        "shape",
        "units",
        "variance",
        "regularity",
        "support",
        "uncertainty",
        "domain_id",
        "codomain_id",
        "tags"
      ],
      "properties": {
        "structure": {"type": "string"},
        "scalar_system": {"type": "string"},
        "shape": {
          "type": "array",
          "items": {"type": ["integer", "string"]}
        },
        "units": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "variance": {
          "type": "array",
          "items": {"type": "string"}
        },
        "regularity": {"type": "string"},
        "support": {"type": "string", "minLength": 1},
        "uncertainty": {
          "type": "object",
          "required": ["model", "parameters"],
          "properties": {
            "model": {"type": "string"},
            "parameters": {"type": "object"}
          },
          "additionalProperties": false
        },
        "domain_id": {"type": ["string", "null"]},
        "codomain_id": {"type": ["string", "null"]},
        "tags": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": ["object", "null"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "locator": {"type": "string"},
        "method": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "license": {"type": ["string", "null"]},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["source", "locator", "method", "confidence", "license", "notes"],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": [
        "node_id",
        "kind",
        "label",
        "math_type",
        "value",
        "attributes",
        "provenance"
      ],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "math_type": {
          "anyOf": [
            {"$ref": "#/$defs/mathType"},
            {"type": "null"}
          ]
        },
        "value": {},
        "attributes": {"type": "object"},
        "provenance": {"$ref": "#/$defs/provenance"}
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["edge_id", "source", "target", "kind", "attributes"],
      "properties": {
        "edge_id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "attributes": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}

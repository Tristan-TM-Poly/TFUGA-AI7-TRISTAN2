{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tristan.local/schemas/n_order_measurements.schema.json",
  "title": "N-order subset measurements",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["components", "value"],
    "properties": {
      "components": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
      "value": {"type": "number"},
      "standard_error": {"type": "number", "minimum": 0},
      "integration_cost": {"type": "number", "minimum": 0},
      "debt": {"type": "number", "minimum": 0},
      "residual_risk": {"type": "number", "minimum": 0},
      "context_id": {"type": "string"},
      "provenance": {"type": "array", "items": {"type": "string"}}
    },
    "additionalProperties": false
  }
}

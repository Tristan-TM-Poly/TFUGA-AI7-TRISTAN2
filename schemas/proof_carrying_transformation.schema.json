{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tristan.example/schemas/proof_carrying_transformation.schema.json",
  "title": "ProofCarryingTransformation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transformation_id",
    "before_hash",
    "after_hash",
    "generator_id",
    "verifier_id",
    "action",
    "allowed_actions",
    "input_status",
    "output_status",
    "evidence_status",
    "provenance",
    "tests",
    "risk_score"
  ],
  "properties": {
    "transformation_id": {"type": "string", "minLength": 1},
    "before_hash": {"type": "string", "minLength": 1},
    "after_hash": {"type": "string", "minLength": 1},
    "generator_id": {"type": "string", "minLength": 1},
    "verifier_id": {"type": "string", "minLength": 1},
    "action": {"type": "string", "minLength": 1},
    "allowed_actions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "input_status": {"$ref": "#/$defs/epistemicStatus"},
    "output_status": {"$ref": "#/$defs/epistemicStatus"},
    "evidence_status": {"$ref": "#/$defs/epistemicStatus"},
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "assumptions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "rollback": {"type": ["string", "null"]},
    "compensation": {"type": ["string", "null"]},
    "risk_score": {"type": "number", "minimum": 0},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verified_gain": {"type": "number"},
        "information_gain": {"type": "number"},
        "transfer": {"type": "number"},
        "regenerability": {"type": "number"},
        "optionality": {"type": "number"},
        "future_work_eliminated": {"type": "number"},
        "complexity": {"type": "number"},
        "risk": {"type": "number"},
        "human_friction": {"type": "number"},
        "epistemic_debt": {"type": "number"},
        "complexity_rent": {"type": "number"}
      }
    }
  },
  "$defs": {
    "epistemicStatus": {
      "type": "string",
      "enum": [
        "FALSIFIED",
        "GENERATED",
        "SPECULATIVE",
        "HYPOTHESIS",
        "DERIVED",
        "SIMULATED",
        "OBSERVED",
        "REPLICATED",
        "CAUSALLY_SUPPORTED"
      ]
    }
  }
}

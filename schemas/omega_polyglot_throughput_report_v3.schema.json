{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/omega_polyglot_throughput_report_v3.schema.json",
  "title": "Omega Polyglot Throughput Report V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "algorithm",
    "scalar",
    "seed",
    "warmups",
    "repetitions",
    "sizes",
    "status",
    "universal_language_winner_claimed",
    "energy_measured"
  ],
  "properties": {
    "algorithm": {
      "const": "vector_affine_f64"
    },
    "scalar": {
      "type": "number"
    },
    "seed": {
      "type": "integer"
    },
    "warmups": {
      "type": "integer",
      "minimum": 0
    },
    "repetitions": {
      "type": "integer",
      "minimum": 1
    },
    "sizes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sizeBenchmark"
      }
    },
    "status": {
      "const": "OAK_LOCAL_SOFTWARE_BENCHMARK_ONLY"
    },
    "universal_language_winner_claimed": {
      "const": false
    },
    "energy_measured": {
      "const": false
    }
  },
  "$defs": {
    "nullableNumber": {
      "type": ["number", "null"]
    },
    "nullableInteger": {
      "type": ["integer", "null"]
    },
    "modeMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "mode",
        "available",
        "correct",
        "median_ns",
        "p95_ns",
        "mean_ns",
        "setup_ns",
        "max_abs_error",
        "speedup_vs_python",
        "effective_gib_per_s",
        "repetitions",
        "notes"
      ],
      "properties": {
        "backend": {
          "enum": ["c", "cpp", "rust"]
        },
        "mode": {
          "enum": [
            "end_to_end_list",
            "zero_copy_buffer",
            "kernel_only_prepared"
          ]
        },
        "available": {
          "type": "boolean"
        },
        "correct": {
          "type": "boolean"
        },
        "median_ns": {
          "$ref": "#/$defs/nullableInteger"
        },
        "p95_ns": {
          "$ref": "#/$defs/nullableInteger"
        },
        "mean_ns": {
          "$ref": "#/$defs/nullableNumber"
        },
        "setup_ns": {
          "$ref": "#/$defs/nullableInteger"
        },
        "max_abs_error": {
          "$ref": "#/$defs/nullableNumber"
        },
        "speedup_vs_python": {
          "$ref": "#/$defs/nullableNumber"
        },
        "effective_gib_per_s": {
          "$ref": "#/$defs/nullableNumber"
        },
        "repetitions": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sizeBenchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size",
        "bytes_per_call",
        "python_median_ns",
        "measurements",
        "best_correct_backend",
        "best_correct_mode",
        "best_speedup_vs_python"
      ],
      "properties": {
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "bytes_per_call": {
          "type": "integer",
          "minimum": 0
        },
        "python_median_ns": {
          "type": "integer",
          "minimum": 1
        },
        "measurements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/modeMeasurement"
          }
        },
        "best_correct_backend": {
          "type": ["string", "null"],
          "enum": ["c", "cpp", "rust", null]
        },
        "best_correct_mode": {
          "type": ["string", "null"],
          "enum": [
            "end_to_end_list",
            "zero_copy_buffer",
            "kernel_only_prepared",
            null
          ]
        },
        "best_speedup_vs_python": {
          "$ref": "#/$defs/nullableNumber"
        }
      }
    }
  }
}

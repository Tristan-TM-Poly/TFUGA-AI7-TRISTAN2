{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tristan.local/schemas/omega_ci_causal_model_v4.schema.json",
  "title": "Omega CI causal model v4",
  "type": "object",
  "required": ["failure_id", "hypotheses"],
  "properties": {
    "failure_id": {"type": "string", "minLength": 1},
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["hypothesis_id", "statement", "prior_weight"],
        "properties": {
          "hypothesis_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "cause_node_ids": {"type": "array", "items": {"type": "string"}},
          "prior_weight": {"type": "number", "exclusiveMinimum": 0},
          "assumptions": {"type": "array", "items": {"type": "string"}},
          "falsifiers": {"type": "array", "items": {"type": "string"}},
          "scope": {"type": "array", "items": {"type": "string"}},
          "severity": {"enum": ["low", "medium", "high", "critical"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

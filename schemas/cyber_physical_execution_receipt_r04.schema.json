{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cyber_physical_execution_receipt_r04.schema.json",
  "title": "Omega CPS R0.4 Execution Receipt",
  "type": "object",
  "required": [
    "connector_id",
    "adapter_type",
    "spec_hash",
    "argv",
    "status",
    "process_started",
    "exit_code",
    "timed_out",
    "duration_s",
    "stdout",
    "stderr",
    "output_json",
    "output_valid",
    "missing_required_keys",
    "artifacts",
    "success",
    "integration_active",
    "execution_proven_for_this_run",
    "environment_fingerprint",
    "physics_certified",
    "hardware_validated",
    "safety_certified",
    "standards_compliance_claim",
    "permanent_total_cap",
    "limitations",
    "evidence_hash"
  ],
  "properties": {
    "connector_id": {"type": "string", "minLength": 1},
    "adapter_type": {
      "enum": ["FMI_FMU", "MODELICA", "SPICE", "ROS2", "CAN", "OPCUA", "REFERENCE_LOOPBACK"]
    },
    "spec_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "status": {"type": "string", "minLength": 1},
    "process_started": {"type": "boolean"},
    "exit_code": {"type": ["integer", "null"]},
    "timed_out": {"type": "boolean"},
    "duration_s": {"type": "number", "minimum": 0},
    "stdout": {"type": "string"},
    "stderr": {"type": "string"},
    "output_json": {"type": ["object", "null"]},
    "output_valid": {"type": "boolean"},
    "missing_required_keys": {"type": "array", "items": {"type": "string"}},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "exists", "size_bytes", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "exists": {"type": "boolean"},
          "size_bytes": {"type": ["integer", "null"], "minimum": 0},
          "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "success": {"type": "boolean"},
    "integration_active": {"type": "boolean"},
    "execution_proven_for_this_run": {"type": "boolean"},
    "environment_fingerprint": {"type": "object", "additionalProperties": {"type": "string"}},
    "physics_certified": {"const": false},
    "hardware_validated": {"const": false},
    "safety_certified": {"const": false},
    "standards_compliance_claim": {"const": false},
    "permanent_total_cap": {"type": "null"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}

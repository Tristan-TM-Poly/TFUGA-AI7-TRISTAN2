{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tristan.invalid/schemas/cyber_physical_energy_graph_r02.schema.json",
  "title": "Omega Cyber Physical EnergyGraph R0.2",
  "type": "object",
  "required": [
    "scenario_id",
    "source_report_hash",
    "terms",
    "balances",
    "global_supplied_energy_j",
    "global_accounted_energy_j",
    "global_residual_j",
    "global_normalized_residual",
    "absolute_source_energy_j",
    "residual_tolerance_j",
    "balance_passed",
    "passivity",
    "sample_count",
    "finite",
    "evidence_hash",
    "energy_conservation_proven",
    "physics_certified",
    "hardware_validated"
  ],
  "properties": {
    "scenario_id": {"type": "string", "minLength": 1},
    "source_report_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "terms": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["term_id", "category", "energy_j", "expected_sign", "interpretation", "intermediate_conversion"],
        "properties": {
          "term_id": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "energy_j": {"type": "number"},
          "expected_sign": {"enum": ["nonnegative", "signed", "zero"]},
          "interpretation": {"type": "string", "minLength": 1},
          "intermediate_conversion": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "balances": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "balance_id", "supplied_energy_j", "accounted_energy_j", "residual_j",
          "normalized_residual", "tolerance_j", "passed", "terms"
        ],
        "properties": {
          "balance_id": {"enum": ["electrical", "thermal", "mechanical", "global"]},
          "supplied_energy_j": {"type": "number"},
          "accounted_energy_j": {"type": "number"},
          "residual_j": {"type": "number"},
          "normalized_residual": {"type": "number", "minimum": 0},
          "tolerance_j": {"type": "number", "exclusiveMinimum": 0},
          "passed": {"type": "boolean"},
          "terms": {"type": "array", "minItems": 2, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "global_supplied_energy_j": {"type": "number"},
    "global_accounted_energy_j": {"type": "number"},
    "global_residual_j": {"type": "number"},
    "global_normalized_residual": {"type": "number", "minimum": 0},
    "absolute_source_energy_j": {"type": "number", "minimum": 0},
    "residual_tolerance_j": {"type": "number", "exclusiveMinimum": 0},
    "balance_passed": {"type": "boolean"},
    "passivity": {
      "type": "object",
      "required": [
        "classification", "nonnegative_dissipation_satisfied",
        "negative_dissipation_candidate_j", "conversion_loss_j",
        "bidirectional_conversion_observed", "energy_creation_candidate_j",
        "tolerance_j", "passivity_proven", "physical_validation"
      ],
      "properties": {
        "classification": {"type": "string", "minLength": 1},
        "nonnegative_dissipation_satisfied": {"type": "boolean"},
        "negative_dissipation_candidate_j": {"type": "number", "minimum": 0},
        "conversion_loss_j": {"type": "number"},
        "bidirectional_conversion_observed": {"type": "boolean"},
        "energy_creation_candidate_j": {"type": "number", "minimum": 0},
        "tolerance_j": {"type": "number", "exclusiveMinimum": 0},
        "passivity_proven": {"const": false},
        "physical_validation": {"const": false}
      },
      "additionalProperties": false
    },
    "sample_count": {"type": "integer", "minimum": 2},
    "finite": {"type": "boolean"},
    "evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "energy_conservation_proven": {"const": false},
    "physics_certified": {"const": false},
    "hardware_validated": {"const": false},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tristan-tm-poly.github.io/schemas/omega_problem_atlas_max_report_v3.schema.json",
  "title": "Omega Problem Atlas MAX Report V3",
  "type": "object",
  "required": [
    "schema",
    "status",
    "source_count",
    "seed_problem_count",
    "deduplicated_problem_count",
    "front_count",
    "target_kind_count",
    "research_target_count",
    "attack_mode_count",
    "research_cell_count",
    "method_family_count",
    "hyperedge_count",
    "portfolio_coverage",
    "scoring_basis",
    "manifest_digest",
    "permanent_total_cap",
    "solution_claimed",
    "formal_proof_claimed",
    "scientific_validation_claimed"
  ],
  "properties": {
    "schema": {"const": "omega-problem-atlas-report-max/3"},
    "status": {"const": "CERTIFIED_SOFTWARE_RESEARCH_FIXTURE_R0_3_MAX"},
    "source_count": {"type": "integer", "minimum": 1},
    "seed_problem_count": {"const": 72},
    "imported_problem_count": {"type": "integer", "minimum": 0},
    "deduplicated_problem_count": {"type": "integer", "minimum": 72},
    "front_count": {"const": 24},
    "target_kind_count": {"const": 12},
    "research_target_count": {"type": "integer", "minimum": 864},
    "attack_mode_count": {"const": 8},
    "research_cell_count": {"type": "integer", "minimum": 6912},
    "method_family_count": {"const": 32},
    "hyperedge_count": {"type": "integer", "minimum": 8568},
    "unresolved_source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "records_requiring_status_refresh": {"type": "integer", "minimum": 0},
    "records_claiming_current_open_status": {"const": 0},
    "records_claiming_solution": {"const": 0},
    "targets_claiming_proof_or_solution": {"const": 0},
    "cells_claiming_proof_or_solution": {"const": 0},
    "portfolio_coverage": {
      "type": "object",
      "required": ["fronts", "problems", "targets", "methods"],
      "properties": {
        "fronts": {"const": 24},
        "problems": {"type": "integer", "minimum": 24},
        "targets": {"type": "integer", "minimum": 24},
        "methods": {"type": "integer", "minimum": 8}
      },
      "additionalProperties": false
    },
    "scoring_basis": {"const": "transparent_profile_v1"},
    "manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "logical_frontier_formula": {"type": "string", "minLength": 1},
    "permanent_total_cap": {"type": "null"},
    "finite_materialization_is_not_proof": {"const": true},
    "current_status_certification_claimed": {"const": false},
    "solution_claimed": {"const": false},
    "formal_proof_claimed": {"const": false},
    "scientific_validation_claimed": {"const": false},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}

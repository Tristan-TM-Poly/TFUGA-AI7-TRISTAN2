{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tristan.example/schemas/omega-depth-node.schema.json",
  "title": "Ω-DEPTH-T∞ Node Contract",
  "type": "object",
  "required": ["id", "name", "depth", "path", "parent_id", "root_creation", "role", "oak_status", "code_status", "ip_status", "risk_level"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_+\\-\\.]+$"},
    "name": {"type": "string", "minLength": 1},
    "depth": {"type": "integer", "minimum": 0},
    "path": {"type": "string", "minLength": 1},
    "parent_id": {"type": ["string", "null"]},
    "root_creation": {"type": "string", "minLength": 1},
    "role": {"type": "string"},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "interfaces": {"type": "array", "items": {"type": "string"}},
    "scientific_basis": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "invariants": {"type": "array", "items": {"type": "string"}},
    "failure_modes": {"type": "array", "items": {"type": "string"}},
    "oak_status": {"enum": ["fertile", "defined", "coded", "tested", "benchmarked", "measured", "validated"]},
    "code_status": {"enum": ["absent", "skeleton", "runnable", "tested"]},
    "ip_status": {"enum": ["public", "review_required", "patent_candidate", "trade_secret"]},
    "risk_level": {"enum": ["low", "medium", "high", "restricted"]},
    "tests": {"type": "array", "items": {"type": "string"}},
    "baselines": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "m_plus": {"type": "array", "items": {"type": "string"}},
    "m_minus": {"type": "array", "items": {"type": "string"}},
    "product_path": {"type": "array", "items": {"type": "string"}},
    "next_proof": {"type": "string"},
    "next_action_under_2h": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}

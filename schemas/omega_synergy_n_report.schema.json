{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/omega_synergy_n_report.schema.json",
  "title": "Omega Synergy Foundry Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "engine",
    "authority",
    "repo_roots",
    "parameters",
    "counts",
    "synergies_by_order",
    "m_minus",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "engine": {"const": "OMEGA-SYNERGY-T-FOUNDRY"},
    "authority": {"const": "review_only_heuristic"},
    "repo_roots": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "parameters": {"type": "object"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creations",
        "graph_edges",
        "synergy_candidates",
        "experiments",
        "pr_genes",
        "meta_synergies",
        "product_hypotheses"
      ],
      "properties": {
        "creations": {"type": "integer", "minimum": 0},
        "graph_edges": {"type": "integer", "minimum": 0},
        "synergy_candidates": {"type": "integer", "minimum": 0},
        "experiments": {"type": "integer", "minimum": 0},
        "pr_genes": {"type": "integer", "minimum": 0},
        "meta_synergies": {"type": "integer", "minimum": 0},
        "product_hypotheses": {"type": "integer", "minimum": 0}
      }
    },
    "synergies_by_order": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"$ref": "#/$defs/candidate"}
      }
    },
    "m_minus": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "diagnostics": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "tensor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_resonance",
        "complementarity",
        "interface_compatibility",
        "closure_gain",
        "evidence",
        "causal_readiness",
        "reuse",
        "option_value",
        "product_value",
        "risk",
        "integration_cost",
        "uncertainty",
        "debt",
        "total"
      ],
      "properties": {
        "semantic_resonance": {"type": "number", "minimum": 0, "maximum": 1},
        "complementarity": {"type": "number", "minimum": 0, "maximum": 1},
        "interface_compatibility": {"type": "number", "minimum": 0, "maximum": 1},
        "closure_gain": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "number", "minimum": 0, "maximum": 1},
        "causal_readiness": {"type": "number", "minimum": 0, "maximum": 1},
        "reuse": {"type": "number", "minimum": 0, "maximum": 1},
        "option_value": {"type": "number", "minimum": 0, "maximum": 1},
        "product_value": {"type": "number", "minimum": 0, "maximum": 1},
        "risk": {"type": "number", "minimum": 0, "maximum": 1},
        "integration_cost": {"type": "number", "minimum": 0, "maximum": 1},
        "uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
        "debt": {"type": "number", "minimum": 0, "maximum": 1},
        "total": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "systems",
        "order",
        "stage",
        "authority",
        "tensor",
        "transformations",
        "matched_needs",
        "proposed_interfaces",
        "anti_synergy_flags",
        "causal_hypothesis",
        "simplest_baseline",
        "provenance",
        "generated_at"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^SYN-[0-9a-f]{16}$"},
        "systems": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "order": {"type": "integer", "minimum": 2, "maximum": 8},
        "stage": {"type": "string", "pattern": "^S[0-9]{1,2}_"},
        "authority": {"const": "review_only_heuristic"},
        "tensor": {"$ref": "#/$defs/tensor"},
        "transformations": {"type": "array", "items": {"type": "string"}},
        "matched_needs": {"type": "array", "items": {"type": "string"}},
        "proposed_interfaces": {"type": "array", "items": {"type": "object"}},
        "anti_synergy_flags": {"type": "array", "items": {"type": "string"}},
        "causal_hypothesis": {"type": "string"},
        "simplest_baseline": {"type": "string"},
        "provenance": {"type": "array", "items": {"type": "string"}},
        "generated_at": {"type": "string"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tristan.example/schemas/omega_prototype_snapshot.schema.json",
  "title": "Omega Prototype Portfolio Snapshot R0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshot_id", "observed_at", "source_heads", "prototypes", "policy_version", "external_action_performed", "truth_probability_claimed"],
  "properties": {
    "snapshot_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "minLength": 1},
    "policy_version": {"const": "r0.1"},
    "external_action_performed": {"const": false},
    "truth_probability_claimed": {"const": false},
    "source_heads": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{40}$"}},
    "prototypes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["prototype_id", "name", "category", "repository", "ref", "summary", "dimensions", "signals", "evidence", "claim", "risks", "next_action", "relations", "tags"],
        "properties": {
          "prototype_id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1},
          "category": {"enum": ["science", "mathematics", "infrastructure", "product", "operations", "theory"]},
          "repository": {"type": "string", "minLength": 1}, "ref": {"type": "string", "minLength": 1}, "summary": {"type": "string"},
          "dimensions": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 5}},
          "signals": {"type": "object", "additionalProperties": {"type": "boolean"}},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
          "claim": {"type": "object"}, "risks": {"type": "array", "items": {"type": "string"}},
          "next_action": {"type": "object"}, "relations": {"type": "array", "items": {"type": "object"}}, "tags": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}

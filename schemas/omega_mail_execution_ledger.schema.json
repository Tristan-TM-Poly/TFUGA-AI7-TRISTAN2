{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tristan.example/schemas/omega_mail_execution_ledger.schema.json",
  "title": "Ω-MAIL-T execution ledger entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sequence",
    "event",
    "message_hash",
    "recipient_hash",
    "provider",
    "occurred_at",
    "reservation_id",
    "previous_hash",
    "detail",
    "entry_hash"
  ],
  "properties": {
    "sequence": {"type": "integer", "minimum": 1},
    "event": {
      "type": "string",
      "enum": ["RESERVED", "ACCEPTED_BY_PROVIDER", "DELIVERED", "SEND_ERROR"]
    },
    "message_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "recipient_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "provider": {"type": "string", "minLength": 1, "maxLength": 128},
    "occurred_at": {"type": "string", "format": "date-time"},
    "reservation_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "previous_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "detail": {"type": "string", "maxLength": 512},
    "entry_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}

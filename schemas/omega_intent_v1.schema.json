{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tristan-tm-poly.github.io/schemas/omega_intent_v1.schema.json",
  "title": "Omega Intent Contract v1",
  "type": "object",
  "required": [
    "objective",
    "expected_outputs",
    "epistemic_constraints",
    "completion_conditions"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^INTENT-[A-Z0-9-]+$"},
    "objective": {"type": "string", "minLength": 1},
    "expected_outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "epistemic_constraints": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "completion_conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "mode": {"enum": ["focused", "expansive", "frontier"]},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}

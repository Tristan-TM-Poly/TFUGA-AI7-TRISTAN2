{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tristan-tm-poly.github.io/schemas/omega_org_registry_r02.schema.json",
  "title": "Omega Organic Family Registry R0.2",
  "type": "object",
  "required": ["version", "axes", "fingerprint"],
  "properties": {
    "version": {"type": "string"},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "axes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "values", "provenance", "status"], "properties": {"name": {"type": "string", "minLength": 1}, "values": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "provenance": {"type": "string"}, "status": {"type": "string"}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}

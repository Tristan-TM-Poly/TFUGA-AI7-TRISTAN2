{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tristan.example/schemas/omega_release_candidate.schema.json",
  "title": "Omega Release Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_id",
    "repository",
    "commit_sha",
    "version",
    "tag",
    "artifacts",
    "validations",
    "changelog_hash",
    "sbom_hash",
    "created_at"
  ],
  "properties": {
    "release_id": {"type": "string", "pattern": "^REL-[A-Z0-9_-]+$"},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256", "media_type", "size_bytes"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "media_type": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "validations": {
      "type": "object",
      "required": ["tests", "licenses", "sbom", "install", "security"],
      "properties": {
        "tests": {"const": "PASS"},
        "licenses": {"const": "PASS"},
        "sbom": {"const": "PASS"},
        "install": {"const": "PASS"},
        "security": {"enum": ["PASS", "NOT_APPLICABLE"]}
      }
    },
    "changelog_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sbom_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "source_issue": {"type": ["integer", "null"], "minimum": 1}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tristan-web-os.local/schema/theory.schema.json",
  "title": "Tristan Web OS public theory",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id", "symbol", "title", "summary", "domains", "maturity", "evidence",
    "artifacts", "oak", "status_note", "next_action", "source_path",
    "family", "version", "visibility", "risks", "publication", "links"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^omega-[a-z0-9-]+$" },
    "symbol": { "type": "string", "minLength": 3 },
    "title": { "type": "string", "minLength": 5 },
    "summary": { "type": "string", "minLength": 20 },
    "domains": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
    "maturity": { "enum": ["hypothèse", "architecture", "prototype", "testé", "reproduit", "produit"] },
    "evidence": { "type": "string", "minLength": 3 },
    "artifacts": { "type": "integer", "minimum": 0 },
    "oak": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verite", "utilite", "testabilite", "simplicite", "valeur", "protection"],
      "properties": {
        "verite": { "$ref": "#/$defs/unitInterval" },
        "utilite": { "$ref": "#/$defs/unitInterval" },
        "testabilite": { "$ref": "#/$defs/unitInterval" },
        "simplicite": { "$ref": "#/$defs/unitInterval" },
        "valeur": { "$ref": "#/$defs/unitInterval" },
        "protection": { "$ref": "#/$defs/unitInterval" }
      }
    },
    "status_note": { "type": "string", "minLength": 15 },
    "next_action": { "type": "string", "minLength": 15 },
    "source_path": { "type": "string", "minLength": 3 },
    "family": { "type": "string", "minLength": 2 },
    "claims_count": { "type": "integer", "minimum": 0 },
    "version": { "type": "string", "minLength": 2 },
    "updated_at": { "type": "string", "format": "date" },
    "visibility": { "enum": ["public-summary", "partner", "private", "ip-vault"] },
    "audiences": { "type": "array", "items": { "type": "string" } },
    "keywords": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "risks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oak_gate", "ip_gate", "privacy_gate", "security_gate", "scope", "automatic_external_action"],
      "properties": {
        "oak_gate": { "type": "boolean" },
        "ip_gate": { "type": "boolean" },
        "privacy_gate": { "type": "boolean" },
        "security_gate": { "type": "boolean" },
        "scope": { "type": "string" },
        "automatic_external_action": { "const": false }
      }
    },
    "links": {
      "type": "object",
      "required": ["detail_route", "claims_route", "source_route"],
      "properties": {
        "detail_route": { "type": "string", "pattern": "^#/theory/" },
        "claims_route": { "type": "string", "pattern": "^#/claims" },
        "source_route": { "type": "string", "pattern": "^#/sources" }
      }
    }
  },
  "$defs": {
    "unitInterval": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}

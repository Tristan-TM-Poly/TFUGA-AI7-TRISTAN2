{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tristan-web-os.local/schema/relation.schema.json",
  "title": "Tristan Web OS navigation relation",
  "description": "A directed navigation link. Referential integrity and the no-self-loop rule are enforced by the R0.3 audit because they depend on the complete catalog.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id", "source", "target", "kind", "rationale", "strength",
    "status", "directional", "evidence_required", "public_scope"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^relation-[0-9]{4}$" },
    "source": { "type": "string", "pattern": "^omega-[a-z0-9-]+$" },
    "target": { "type": "string", "pattern": "^omega-[a-z0-9-]+$" },
    "kind": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
    "rationale": { "type": "string", "minLength": 15 },
    "strength": { "type": "number", "minimum": 0, "maximum": 1 },
    "status": { "enum": ["curated-candidate", "tested-association", "deprecated"] },
    "directional": { "type": "boolean" },
    "evidence_required": { "const": true },
    "public_scope": { "const": "navigation" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tristan-web-os.local/schema/claim.schema.json",
  "title": "Tristan Web OS public claim",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id", "theory_id", "kind", "title", "statement", "status",
    "epistemic_level", "confidence_label", "support", "counter_hypotheses",
    "falsification_or_limit", "next_test", "risk_tags", "publication_scope",
    "automatic_promotion", "updated_at"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^claim-omega-[a-z0-9-]+-[0-9]{2}$" },
    "theory_id": { "type": "string", "pattern": "^omega-[a-z0-9-]+$" },
    "kind": { "enum": ["scope", "limit", "test-plan", "result", "mechanism", "application", "safety"] },
    "title": { "type": "string", "minLength": 5 },
    "statement": { "type": "string", "minLength": 20 },
    "status": { "enum": ["candidate", "guardrail", "planned", "tested", "supported", "refuted", "deprecated"] },
    "epistemic_level": { "type": "string", "minLength": 4 },
    "confidence_label": { "type": "string", "minLength": 3 },
    "support": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "path", "locator", "note"],
        "properties": {
          "type": { "type": "string", "minLength": 3 },
          "path": { "type": "string", "minLength": 3 },
          "locator": { "type": "string", "minLength": 1 },
          "note": { "type": "string", "minLength": 8 }
        }
      }
    },
    "counter_hypotheses": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 8 } },
    "falsification_or_limit": { "type": "string", "minLength": 15 },
    "next_test": { "type": "string", "minLength": 15 },
    "risk_tags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "publication_scope": { "type": "string", "minLength": 3 },
    "automatic_promotion": { "const": false },
    "updated_at": { "type": "string", "format": "date" }
  }
}

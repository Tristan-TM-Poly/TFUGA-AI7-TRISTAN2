{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiome-tristan.invalid/schemas/research_civilization_seed_v1.schema.json",
  "title": "Research Civilization BOOK0 Seed v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["question", "residual_ids", "unit_blueprints", "verified_claims", "policy", "source_plan_hash", "version"],
  "properties": {
    "question": {"type": "string", "minLength": 1},
    "residual_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "unit_blueprints": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "array",
        "prefixItems": [
          {"type": "string", "minLength": 1},
          {"enum": ["university", "research_group", "virtual_tristan", "ait", "llmt", "allt", "simulation_lab", "scientific_court", "verifier"]},
          {"type": "string", "minLength": 1},
          {"type": "integer", "minimum": 0},
          {"type": "array", "items": {"type": "string"}},
          {"type": ["string", "null"]}
        ],
        "minItems": 6,
        "maxItems": 6
      }
    },
    "verified_claims": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {"type": "string", "minLength": 1},
          {"type": "string", "minLength": 1},
          {"type": "integer", "minimum": 5, "maximum": 7},
          {"type": "integer", "minimum": 5, "maximum": 7},
          {"type": "string", "minLength": 1},
          {"type": "string", "minLength": 1},
          {"type": "string", "minLength": 1},
          {"type": "array", "minItems": 1, "items": {"type": "string"}},
          {"type": "array", "minItems": 1, "items": {"type": "string"}}
        ],
        "minItems": 9,
        "maxItems": 9
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_depth", "max_materialized_units", "minimum_spawn_margin", "minimum_unit_utility", "high_complexity_threshold"],
      "properties": {
        "max_depth": {"type": "integer", "minimum": 0},
        "max_materialized_units": {"type": "integer", "minimum": 3},
        "minimum_spawn_margin": {"type": "number"},
        "minimum_unit_utility": {"type": "number"},
        "high_complexity_threshold": {"type": "number"}
      }
    },
    "source_plan_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/omega_web_hg_policy_profile_v1.schema.json",
  "title": "Omega Web HG R0.5 Policy Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "policy_url",
    "policy_observed_at",
    "policy_status",
    "allowed_routes",
    "allowed_content",
    "allowed_fields",
    "forbidden_content",
    "forbidden_fields",
    "required_environment",
    "request_rate",
    "required_identity",
    "retention",
    "attribution",
    "review",
    "enforcement_mode",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "omega-web-hg-policy-profile/1.0"},
    "source_id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "policy_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "policy_observed_at": {"type": "string", "format": "date"},
    "policy_status": {
      "enum": ["verified", "inferred", "ambiguous", "expired", "human_review_required"]
    },
    "allowed_routes": {"$ref": "#/$defs/uniqueStringsNonEmpty"},
    "allowed_content": {"$ref": "#/$defs/uniqueStrings"},
    "allowed_fields": {"$ref": "#/$defs/uniqueStrings"},
    "forbidden_content": {"$ref": "#/$defs/uniqueStrings"},
    "forbidden_fields": {"$ref": "#/$defs/uniqueStrings"},
    "required_environment": {"$ref": "#/$defs/uniqueStrings"},
    "request_rate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended_rps", "maximum_rps", "burst", "retry_after_required"],
      "properties": {
        "recommended_rps": {"type": "number", "exclusiveMinimum": 0},
        "maximum_rps": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "burst": {"type": "integer", "minimum": 1},
        "retry_after_required": {"type": "boolean"}
      }
    },
    "required_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_agent_required", "contact_email"],
      "properties": {
        "user_agent_required": {"type": "boolean"},
        "contact_email": {"enum": ["required", "recommended", "optional", "forbidden"]}
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_response", "normalized_metadata", "maximum_days", "encrypted_at_rest"],
      "properties": {
        "raw_response": {"enum": ["forbidden", "ephemeral", "allowed"]},
        "normalized_metadata": {"enum": ["forbidden", "ephemeral", "allowed"]},
        "maximum_days": {"type": ["integer", "null"], "minimum": 1},
        "encrypted_at_rest": {"type": "boolean"}
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "required_fields"],
      "properties": {
        "required": {"type": "boolean"},
        "required_fields": {"$ref": "#/$defs/uniqueStrings"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_after_days", "next_review_at"],
      "properties": {
        "review_after_days": {"type": "integer", "minimum": 1},
        "next_review_at": {"type": ["string", "null"], "format": "date"}
      }
    },
    "enforcement_mode": {"enum": ["reject", "redact"]},
    "jurisdiction": {"type": ["string", "null"]},
    "notes": {"$ref": "#/$defs/uniqueStrings"},
    "profile_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "uniqueStrings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "uniqueStringsNonEmpty": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}

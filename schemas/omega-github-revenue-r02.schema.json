{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/omega-github-revenue-r02.schema.json",
  "title": "Omega GitHub Revenue R0.2 contracts",
  "type": "object",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_id",
        "repository_id",
        "granted_by",
        "granted_at",
        "operations",
        "explicitly_authorized"
      ],
      "properties": {
        "authorization_id": {"type": "string", "minLength": 1},
        "repository_id": {"type": "string", "minLength": 1},
        "granted_by": {"type": "string", "minLength": 1},
        "granted_at": {"type": "string", "format": "date-time"},
        "expires_at": {
          "oneOf": [
            {"type": "string", "format": "date-time"},
            {"type": "null"}
          ]
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "read_metadata",
              "read_text",
              "count_lines",
              "hash_files",
              "scan_risk_patterns",
              "generate_report"
            ]
          }
        },
        "explicitly_authorized": {"const": true},
        "purpose": {"type": "string"},
        "data_classification": {"type": "string"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "category",
        "severity",
        "message",
        "evidence",
        "recommendation"
      ],
      "properties": {
        "finding_id": {"type": "string", "pattern": "^OAK-[a-f0-9]{12}$"},
        "category": {"type": "string", "minLength": 1},
        "severity": {
          "enum": ["info", "review", "medium", "high", "critical"]
        },
        "message": {"type": "string", "minLength": 1},
        "path": {"type": ["string", "null"]},
        "evidence": {
          "type": "array",
          "items": {"type": "string"}
        },
        "recommendation": {"type": "string"}
      }
    },
    "audit_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "authorization_id",
        "files_seen",
        "bytes_seen",
        "text_files_scanned",
        "lines_seen",
        "code_files",
        "test_files",
        "workflow_files",
        "documentation_files",
        "has_license",
        "has_funding",
        "findings",
        "privacy_summary",
        "quality_score",
        "report_hash",
        "limitations"
      ],
      "properties": {
        "repository_id": {"type": "string", "minLength": 1},
        "authorization_id": {"type": "string", "minLength": 1},
        "files_seen": {"type": "integer", "minimum": 0},
        "bytes_seen": {"type": "integer", "minimum": 0},
        "text_files_scanned": {"type": "integer", "minimum": 0},
        "lines_seen": {"type": "integer", "minimum": 0},
        "code_files": {"type": "integer", "minimum": 0},
        "test_files": {"type": "integer", "minimum": 0},
        "workflow_files": {"type": "integer", "minimum": 0},
        "documentation_files": {"type": "integer", "minimum": 0},
        "has_license": {"type": "boolean"},
        "has_funding": {"type": "boolean"},
        "findings": {
          "type": "array",
          "items": {"$ref": "#/$defs/finding"}
        },
        "privacy_summary": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "quality_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "report_hash": {"$ref": "#/$defs/sha256"},
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        }
      }
    },
    "campaign_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_id",
        "seen",
        "accepted",
        "inserted",
        "updated",
        "duplicates",
        "quarantined",
        "final_batch_size",
        "source_exhausted",
        "artifact_merkle_root",
        "receipt_hash",
        "checkpoint_hash"
      ],
      "properties": {
        "campaign_id": {"type": "string", "minLength": 1},
        "seen": {"type": "integer", "minimum": 0},
        "accepted": {"type": "integer", "minimum": 0},
        "inserted": {"type": "integer", "minimum": 0},
        "updated": {"type": "integer", "minimum": 0},
        "duplicates": {"type": "integer", "minimum": 0},
        "quarantined": {"type": "integer", "minimum": 0},
        "final_batch_size": {"type": "integer", "minimum": 1},
        "source_exhausted": {"type": "boolean"},
        "artifact_merkle_root": {"$ref": "#/$defs/sha256"},
        "receipt_hash": {"$ref": "#/$defs/sha256"},
        "checkpoint_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "provider_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "event_id",
        "gross_minor",
        "fee_minor",
        "currency",
        "occurred_at"
      ],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "event_id": {"type": "string", "minLength": 1},
        "gross_minor": {"type": "integer", "minimum": 0},
        "fee_minor": {"type": "integer", "minimum": 0},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "occurred_at": {"type": "string", "format": "date-time"},
        "status": {"type": "string"}
      }
    },
    "funnel_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unique_visitors",
        "sponsor_page_views",
        "sponsor_clicks",
        "sponsorships",
        "service_inquiries",
        "qualified_inquiries",
        "paid_services",
        "repeat_paid_services"
      ],
      "properties": {
        "unique_visitors": {"type": "integer", "minimum": 0},
        "sponsor_page_views": {"type": "integer", "minimum": 0},
        "sponsor_clicks": {"type": "integer", "minimum": 0},
        "sponsorships": {"type": "integer", "minimum": 0},
        "service_inquiries": {"type": "integer", "minimum": 0},
        "qualified_inquiries": {"type": "integer", "minimum": 0},
        "paid_services": {"type": "integer", "minimum": 0},
        "repeat_paid_services": {"type": "integer", "minimum": 0}
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/authorization"},
    {"$ref": "#/$defs/audit_report"},
    {"$ref": "#/$defs/campaign_receipt"},
    {"$ref": "#/$defs/provider_event"},
    {"$ref": "#/$defs/funnel_snapshot"}
  ]
}

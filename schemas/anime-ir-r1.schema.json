      "required": [
        "scene_id",
        "episode_id",
        "sequence_id",
        "order",
        "title",
        "duration_target_s",
        "objective",
        "conflict",
        "irreversible_change",
        "audience_before",
        "audience_after",
        "characters",
        "location_id",
        "promise_ids",
        "causal_debt_ids",
        "asset_ids",
        "oak_status"
      ],
      "type": "object"

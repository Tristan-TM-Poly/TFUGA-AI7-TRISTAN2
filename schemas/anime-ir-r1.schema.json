  "$id": "https://tfuga.example/schemas/anime-ir-r1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assets": {
      "items": {
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "causal_debts": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "characters": {
      "items": {
        "$ref": "#/$defs/character"
      },
      "minItems": 1,
      "type": "array"
    },
    "edges": {
      "items": {
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "logline": {
      "minLength": 20,
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "next_actions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "nodes": {
      "items": {
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "oak_status": {
      "enum": [
        "EXPLORATORY",
        "FORMALIZED",
        "SIMULATED",
        "DEMONSTRATED",
        "REPLICATED",
        "CANONICAL"
      ]
    },
    "project_id": {
      "minLength": 1,
      "type": "string"
    },
    "risks": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/scene"
      },
      "minItems": 1,
      "type": "array"
    },
    "shots": {
      "items": {
        "$ref": "#/$defs/shot"
      },
      "minItems": 1,
      "type": "array"
    },
    "target_duration_s": {
      "minimum": 30,
      "type": "integer"
    },
    "theme_question": {
      "pattern": "\\?$",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "visual_invariants": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "world_rules": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 3,
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "title",
    "logline",
    "theme_question",
    "target_duration_s",
    "world_rules",
    "visual_invariants",
    "characters",
    "scenes",
    "shots",
    "causal_debts",
    "assets",
    "nodes",
    "edges",
    "oak_status",
    "risks",
    "next_actions",
    "metadata"
  ],
  "title": "Omega Anime Studio R1 Anime-IR",
  "type": "object"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/omega_naruto_parallel_validation_v3.schema.json",
  "title": "Omega Naruto Parallel Validation v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "valid",
    "workers",
    "manifest_records",
    "observed_records",
    "manifest_shards",
    "observed_shards",
    "start_ordinal",
    "expected_next_ordinal",
    "observed_next_ordinal",
    "compressed_bytes",
    "uncompressed_bytes",
    "merkle_root_sha256",
    "manifest_merkle_root_sha256",
    "all_record_fields_recomputed",
    "global_stream_sha256_recomputed",
    "manifest_logical_corpus_sha256",
    "elapsed_seconds",
    "records_per_second",
    "findings",
    "shard_proofs",
    "non_claim"
  ],
  "properties": {
    "schema": {"const": "omega_naruto_frontier.parallel_validation.v3"},
    "valid": {"type": "boolean"},
    "workers": {"type": "integer", "minimum": 1},
    "manifest_records": {"type": "integer", "minimum": 0},
    "observed_records": {"type": "integer", "minimum": 0},
    "manifest_shards": {"type": "integer", "minimum": 0},
    "observed_shards": {"type": "integer", "minimum": 0},
    "start_ordinal": {"type": "integer", "minimum": 0},
    "expected_next_ordinal": {"type": "integer", "minimum": 0},
    "observed_next_ordinal": {"type": "integer", "minimum": 0},
    "compressed_bytes": {"type": "integer", "minimum": 0},
    "uncompressed_bytes": {"type": "integer", "minimum": 0},
    "merkle_root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest_merkle_root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "all_record_fields_recomputed": {"const": true},
    "global_stream_sha256_recomputed": {"const": false},
    "manifest_logical_corpus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "records_per_second": {"type": "number", "minimum": 0},
    "findings": {"type": "array", "items": {"type": "object"}},
    "shard_proofs": {"type": "array", "items": {"type": "object"}},
    "non_claim": {"type": "string", "minLength": 1}
  }
}

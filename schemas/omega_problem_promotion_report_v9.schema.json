{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/omega_problem_promotion_report_v9.schema.json",
  "title": "Omega Problem Promotion Report V9",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "gate_ready",
    "blocker_count",
    "check_count",
    "mandatory_check_count",
    "passed_mandatory_check_count",
    "evidence_reference_count",
    "signature_count",
    "m_minus_record_count",
    "receipt_digest",
    "publication_bundle_digest",
    "manifest_digest",
    "dry_run",
    "external_action_performed",
    "proof_claimed",
    "solution_claimed",
    "novelty_claimed_by_compiler",
    "prize_recognition_claimed",
    "report_digest"
  ],
  "properties": {
    "schema": {"const": "omega-problem-promotion-report/9"},
    "request_id": {"type": "string", "minLength": 1},
    "gate_ready": {"type": "boolean"},
    "blocker_count": {"type": "integer", "minimum": 0},
    "check_count": {"type": "integer", "minimum": 0},
    "mandatory_check_count": {"type": "integer", "minimum": 0},
    "passed_mandatory_check_count": {"type": "integer", "minimum": 0},
    "evidence_reference_count": {"type": "integer", "minimum": 0},
    "signature_count": {"type": "integer", "minimum": 0},
    "m_minus_record_count": {"type": "integer", "minimum": 0},
    "receipt_digest": {"$ref": "#/$defs/sha256"},
    "publication_bundle_digest": {"$ref": "#/$defs/sha256"},
    "manifest_digest": {"$ref": "#/$defs/sha256"},
    "dry_run": {"const": true},
    "external_action_performed": {"const": false},
    "proof_claimed": {"const": false},
    "solution_claimed": {"const": false},
    "novelty_claimed_by_compiler": {"const": false},
    "prize_recognition_claimed": {"const": false},
    "report_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

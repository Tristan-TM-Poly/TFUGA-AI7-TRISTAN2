{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tristan.example/schemas/eigenmath_proof_obligation.schema.json",
  "title": "EigenMath Proof Obligation R0.1",
  "type": "object",
  "required": [
    "obligation_id", "problem_id", "statement", "assumptions", "dependencies",
    "status", "producer_id", "verifier_id", "falsifier_id", "provenance", "tests"
  ],
  "properties": {
    "obligation_id": {"type": "string", "minLength": 1},
    "problem_id": {"type": "string", "minLength": 1},
    "statement": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "status": {
      "enum": ["UNPROVEN", "SPECULATIVE", "COMPUTATIONALLY_SUPPORTED", "PROVED_SPECIAL_CASE", "FORMALLY_PROVED", "INDEPENDENTLY_VERIFIED", "FALSIFIED"]
    },
    "producer_id": {"type": "string", "minLength": 1},
    "verifier_id": {"type": "string", "minLength": 1},
    "falsifier_id": {"type": "string", "minLength": 1},
    "provenance": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "tests": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "proof_artifact": {"type": ["string", "null"]},
    "community_acceptance_receipt": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cyber_physical_normalized_exchange_r04.schema.json",
  "title": "Omega CPS R0.4 Normalized Exchange",
  "type": "object",
  "required": [
    "adapter_type",
    "source_id",
    "payload",
    "required_keys",
    "valid",
    "missing_keys",
    "source_execution_receipt_hash",
    "replay_only",
    "live_connection_claim",
    "hardware_validated",
    "standards_compliance_claim",
    "evidence_hash"
  ],
  "properties": {
    "adapter_type": {
      "enum": ["FMI_FMU", "MODELICA", "SPICE", "ROS2", "CAN", "OPCUA", "REFERENCE_LOOPBACK"]
    },
    "source_id": {"type": "string", "minLength": 1},
    "payload": {"type": "object"},
    "required_keys": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "valid": {"type": "boolean"},
    "missing_keys": {"type": "array", "items": {"type": "string"}},
    "source_execution_receipt_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "replay_only": {"type": "boolean"},
    "live_connection_claim": {"const": false},
    "hardware_validated": {"const": false},
    "standards_compliance_claim": {"const": false},
    "evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}

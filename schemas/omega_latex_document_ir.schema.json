{
  "$id": "https://example.invalid/schemas/omega_latex_document_ir.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "meta": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "depth": {
          "minimum": 0,
          "type": "integer"
        },
        "language": {
          "type": "string"
        },
        "template": {
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "type": "object"
    },
    "nodes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "type": "string"
          },
          "dependencies": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "dimension_lhs": {
            "type": "string"
          },
          "dimension_rhs": {
            "type": "string"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "enum": [
              "section",
              "paragraph",
              "definition",
              "axiom",
              "conjecture",
              "lemma",
              "proposition",
              "theorem",
              "corollary",
              "proof",
              "proof_sketch",
              "equation",
              "algorithm",
              "experiment",
              "dataset",
              "result",
              "figure",
              "table",
              "claim",
              "warning",
              "open_question",
              "counterexample",
              "appendix"
            ]
          },
          "math_ir": {
            "type": "object"
          },
          "max_depth": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "metadata": {
            "type": "object"
          },
          "min_depth": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "result_key": {
            "type": "string"
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "status": {
            "type": "string"
          },
          "symbols": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "meaning": {
                  "type": "string"
                },
                "scope": {
                  "type": "string"
                },
                "symbol": {
                  "type": "string"
                },
                "unit": {
                  "type": "string"
                }
              },
              "required": [
                "symbol"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "provenance": {
      "type": "object"
    },
    "results": {
      "type": "object"
    },
    "sources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "citation": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "meta",
    "nodes"
  ],
  "title": "Omega LaTeX Document IR",
  "type": "object"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tristan-TM-Poly/TFUGA-AI7-TRISTAN2/schemas/omega_problem_atlas_report_v3.schema.json",
  "title": "Omega Problem Atlas R0.3 report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "source_count",
    "seed_problem_count",
    "imported_problem_count",
    "deduplicated_problem_count",
    "front_count",
    "attack_mode_count",
    "materialized_research_cell_count",
    "materialized_hyperedge_count",
    "expected_seed_research_cells",
    "unresolved_source_ids",
    "records_requiring_status_refresh",
    "records_claiming_current_open_status",
    "records_claiming_solution",
    "research_cells_claiming_proof",
    "logical_frontier_formula",
    "permanent_total_cap",
    "finite_materialization_is_not_proof",
    "current_status_certification_claimed",
    "solution_claimed",
    "formal_proof_claimed",
    "scientific_validation_claimed",
    "digest"
  ],
  "properties": {
    "schema": {"const": "omega-problem-atlas-report/3"},
    "status": {"const": "CERTIFIED_SOFTWARE_RESEARCH_FIXTURE_R0_3"},
    "source_count": {"type": "integer", "minimum": 1},
    "seed_problem_count": {"type": "integer", "minimum": 72},
    "imported_problem_count": {"type": "integer", "minimum": 0},
    "deduplicated_problem_count": {"type": "integer", "minimum": 1},
    "front_count": {"type": "integer", "minimum": 24},
    "attack_mode_count": {"type": "integer", "minimum": 8},
    "materialized_research_cell_count": {"type": "integer", "minimum": 1},
    "materialized_hyperedge_count": {"type": "integer", "minimum": 1},
    "expected_seed_research_cells": {"type": "integer", "minimum": 576},
    "unresolved_source_ids": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "records_requiring_status_refresh": {"type": "integer", "minimum": 0},
    "records_claiming_current_open_status": {"const": 0},
    "records_claiming_solution": {"const": 0},
    "research_cells_claiming_proof": {"const": 0},
    "logical_frontier_formula": {"type": "string", "minLength": 1},
    "permanent_total_cap": {"type": "null"},
    "finite_materialization_is_not_proof": {"const": true},
    "current_status_certification_claimed": {"const": false},
    "solution_claimed": {"const": false},
    "formal_proof_claimed": {"const": false},
    "scientific_validation_claimed": {"const": false},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

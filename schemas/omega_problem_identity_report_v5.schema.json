{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tristan.invalid/schemas/omega_problem_identity_report_v5.schema.json",
  "title": "Omega Problem Identity Report V5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "source_record_count",
    "canonical_problem_count",
    "automatic_exact_statement_merge_edge_count",
    "manual_merge_edge_count",
    "alias_edge_count",
    "fuzzy_candidate_count",
    "decision_receipt_count",
    "collision_quarantine_count",
    "singleton_count",
    "merged_problem_count",
    "fuzzy_merge_count",
    "title_only_merge_count",
    "solution_claimed",
    "formal_proof_claimed",
    "scientific_validation_claimed",
    "permanent_total_cap",
    "manifest_digest",
    "digest"
  ],
  "properties": {
    "schema": {"const": "omega-problem-identity-report/5"},
    "status": {"const": "CERTIFIED_IDENTITY_GRAPH_FIXTURE_R0_5"},
    "source_record_count": {"type": "integer", "minimum": 0},
    "canonical_problem_count": {"type": "integer", "minimum": 0},
    "automatic_exact_statement_merge_edge_count": {"type": "integer", "minimum": 0},
    "manual_merge_edge_count": {"type": "integer", "minimum": 0},
    "alias_edge_count": {"type": "integer", "minimum": 0},
    "fuzzy_candidate_count": {"type": "integer", "minimum": 0},
    "decision_receipt_count": {"type": "integer", "minimum": 0},
    "collision_quarantine_count": {"type": "integer", "minimum": 0},
    "singleton_count": {"type": "integer", "minimum": 0},
    "merged_problem_count": {"type": "integer", "minimum": 0},
    "fuzzy_merge_count": {"const": 0},
    "title_only_merge_count": {"const": 0},
    "solution_claimed": {"const": false},
    "formal_proof_claimed": {"const": false},
    "scientific_validation_claimed": {"const": false},
    "permanent_total_cap": {"type": "null"},
    "manifest_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}

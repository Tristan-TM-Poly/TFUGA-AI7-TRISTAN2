{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cyber_physical_integration_ledger_r04.schema.json",
  "title": "Omega CPS R0.4 Integration Ledger",
  "type": "object",
  "required": [
    "registry",
    "capabilities",
    "receipts",
    "exchanges",
    "activations",
    "active_connector_count",
    "failed_receipt_count",
    "valid_exchange_count",
    "permanent_total_cap",
    "physics_certified",
    "hardware_validated",
    "safety_certified",
    "standards_compliance_claim",
    "evidence_hash"
  ],
  "properties": {
    "registry": {"type": "array", "minItems": 7, "items": {"type": "object"}},
    "capabilities": {"type": "array", "minItems": 7, "items": {"type": "object"}},
    "receipts": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "exchanges": {"type": "array", "minItems": 7, "items": {"type": "object"}},
    "activations": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "active_connector_count": {"type": "integer", "minimum": 0},
    "failed_receipt_count": {"type": "integer", "minimum": 0},
    "valid_exchange_count": {"type": "integer", "minimum": 0},
    "permanent_total_cap": {"type": "null"},
    "physics_certified": {"const": false},
    "hardware_validated": {"const": false},
    "safety_certified": {"const": false},
    "standards_compliance_claim": {"const": false},
    "evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}

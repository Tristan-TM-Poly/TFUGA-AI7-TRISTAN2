{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tristan-tm-poly.github.io/schemas/omega_org_packed_manifest_r02.schema.json",
  "title": "Omega Organic Family Packed Atlas Manifest R0.2",
  "type": "object",
  "required": ["version", "encoding", "registry_fingerprint", "logical_family_space", "logical_linked_object_space", "family_records", "evidence_records", "total_objects", "family_shards", "evidence_shards", "merkle_root", "oak_boundary"],
  "properties": {
    "version": {"const": "R0.2-ultra-packed"}, "encoding": {"const": "fixed_width_binary_gzip"},
    "registry_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "logical_family_space": {"type": "integer", "minimum": 1}, "logical_linked_object_space": {"type": "integer", "minimum": 4},
    "family_records": {"type": "integer", "minimum": 0}, "evidence_records": {"type": "integer", "minimum": 0}, "total_objects": {"type": "integer", "minimum": 0},
    "merkle_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "oak_boundary": {"type": "string", "minLength": 1},
    "family_shards": {"type": "array", "items": {"$ref": "#/$defs/shard"}}, "evidence_shards": {"type": "array", "items": {"$ref": "#/$defs/shard"}}
  },
  "$defs": {"shard": {"type": "object", "required": ["path", "count", "sha256", "compressed_bytes", "raw_bytes", "record_bytes"], "properties": {"path": {"type": "string"}, "count": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "compressed_bytes": {"type": "integer", "minimum": 0}, "raw_bytes": {"type": "integer", "minimum": 0}, "record_bytes": {"type": "integer", "minimum": 1}}}}
}

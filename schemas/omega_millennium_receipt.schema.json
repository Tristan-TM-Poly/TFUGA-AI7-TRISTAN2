{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/omega_millennium_receipt.schema.json",
  "title": "Omega Millennium Research Receipt R0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["sequence", "previous_digest", "event_type", "payload", "receipt_digest"],
  "properties": {
    "sequence": {"type": "integer", "minimum": 0},
    "previous_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "event_type": {"type": "string", "minLength": 1},
    "payload": {"type": "object"},
    "receipt_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tristan.invalid/schemas/omega_ci_promotion_proof_v2.schema.json",
  "type": "object",
  "required": ["schema", "proof_id", "claim_id", "from_status", "to_status", "evidence_bundle_ids", "validity_statuses", "coverage_score", "coverage_threshold", "prerequisites", "decision", "reasons", "human_review_required", "automatic_merge_allowed"],
  "properties": {
    "schema": {"const": "omega-ci-promotion-proof/v2"},
    "proof_id": {"type": "string", "pattern": "^PROMOTION-[A-F0-9]{20}$"},
    "claim_id": {"type": "string"},
    "from_status": {"type": "string"},
    "to_status": {"type": "string"},
    "evidence_bundle_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "validity_statuses": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "coverage_score": {"type": "number", "minimum": 0, "maximum": 1},
    "coverage_threshold": {"type": "number", "minimum": 0, "maximum": 1},
    "prerequisites": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "decision": {"enum": ["ELIGIBLE_FOR_HUMAN_REVIEW", "BLOCKED"]},
    "reasons": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "human_review_required": {"const": true},
    "automatic_merge_allowed": {"const": false}
  },
  "additionalProperties": false
}

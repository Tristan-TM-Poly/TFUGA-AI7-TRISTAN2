{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tristan.invalid/schemas/omega_ci_evidence_v1.schema.json",
  "title": "Omega CI Evidence Bundle v1",
  "type": "object",
  "required": ["schema", "bundle_id", "run_id", "commit_sha", "proof_plan_id", "proof_plan_digest", "environment", "subject", "claims_tested", "test_results", "properties", "artifacts", "limitations", "decision", "merkle_root"],
  "properties": {
    "schema": {"const": "omega-ci-evidence/v1"},
    "bundle_id": {"type": "string", "pattern": "^EVIDENCE-"},
    "run_id": {"type": "string"},
    "commit_sha": {"type": "string"},
    "proof_plan_id": {"type": "string"},
    "proof_plan_digest": {"type": "string", "minLength": 64, "maxLength": 64},
    "environment": {"type": "object"},
    "subject": {"type": "object"},
    "claims_tested": {"type": "array", "items": {"type": "string"}},
    "test_results": {"type": "array", "items": {"type": "object"}},
    "properties": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "decision": {
      "type": "object",
      "required": ["status", "promotion_allowed", "automatic_merge_allowed", "human_review_required", "reasons"],
      "properties": {
        "status": {"type": "string"},
        "promotion_allowed": {"type": "boolean"},
        "automatic_merge_allowed": {"const": false},
        "human_review_required": {"const": true},
        "reasons": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "parent_bundle_ids": {"type": "array", "items": {"type": "string"}},
    "merkle_root": {"type": "string", "minLength": 64, "maxLength": 64}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/open_problems_lead_r02.schema.json",
  "title": "Omega Open Problems Atlas R0.2 ProblemLead",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "lead_id",
    "source_id",
    "source_locator",
    "title",
    "statement_summary",
    "domains",
    "kind",
    "lead_status",
    "independently_checked_open",
    "finite_computation_is_not_proof",
    "solution_claimed"
  ],
  "properties": {
    "lead_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "source_locator": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "statement_summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "kind": {"type": "string", "minLength": 1},
    "lead_status": {
      "enum": [
        "DISCOVERED",
        "SOURCE_REPORTED",
        "LICENSE_REVIEW_REQUIRED",
        "STATUS_RECHECK_REQUIRED",
        "NORMALIZED",
        "LITERATURE_BASELINED",
        "INDEPENDENTLY_CHECKED_OPEN",
        "PARTIALLY_RESOLVED",
        "RESOLVED",
        "DISPUTED",
        "REJECTED"
      ]
    },
    "source_snapshot_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "independently_checked_open": {"type": "boolean"},
    "finite_computation_is_not_proof": {"const": true},
    "solution_claimed": {"const": false},
    "record_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"independently_checked_open": {"const": true}}},
      "then": {"properties": {"lead_status": {"const": "INDEPENDENTLY_CHECKED_OPEN"}}}
    },
    {
      "if": {"properties": {"kind": {"enum": ["COMPETITION_PROBLEM", "COMPUTATIONAL_CHALLENGE"]}}},
      "then": {"properties": {"independently_checked_open": {"const": false}}}
    }
  ]
}

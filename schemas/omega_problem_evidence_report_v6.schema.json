{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tristan.invalid/schemas/omega_problem_evidence_report_v6.schema.json",
  "title": "Omega Problem Evidence Report V6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "canonical_problem_count",
    "canonical_identity_ref_count",
    "canonical_identity_input_digest",
    "bundle_count",
    "node_count",
    "edge_count",
    "claim_count",
    "assessment_count",
    "promotion_allowed_count",
    "blocked_claim_count",
    "mminus_record_count",
    "contradiction_edge_count",
    "merely_mentions_edge_count",
    "general_proof_from_numerical_evidence_count",
    "mathematical_truth_probability_claimed",
    "solution_claimed",
    "scientific_validation_claimed",
    "permanent_total_cap",
    "manifest_digest",
    "digest"
  ],
  "properties": {
    "schema": {"const": "omega-problem-evidence-report/6"},
    "status": {"const": "CERTIFIED_CLAIM_EVIDENCE_FIXTURE_R0_6"},
    "canonical_problem_count": {"type": "integer", "minimum": 0},
    "canonical_identity_ref_count": {"type": "integer", "minimum": 0},
    "canonical_identity_input_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "bundle_count": {"type": "integer", "minimum": 0},
    "node_count": {"type": "integer", "minimum": 0},
    "edge_count": {"type": "integer", "minimum": 0},
    "claim_count": {"type": "integer", "minimum": 0},
    "assessment_count": {"type": "integer", "minimum": 0},
    "promotion_allowed_count": {"type": "integer", "minimum": 0},
    "blocked_claim_count": {"type": "integer", "minimum": 0},
    "mminus_record_count": {"type": "integer", "minimum": 0},
    "contradiction_edge_count": {"type": "integer", "minimum": 0},
    "merely_mentions_edge_count": {"type": "integer", "minimum": 0},
    "general_proof_from_numerical_evidence_count": {"const": 0},
    "mathematical_truth_probability_claimed": {"const": false},
    "solution_claimed": {"const": false},
    "scientific_validation_claimed": {"const": false},
    "permanent_total_cap": {"type": "null"},
    "manifest_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}

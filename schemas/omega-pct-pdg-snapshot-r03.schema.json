{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/omega-pct-pdg-snapshot-r03.schema.json",
  "title": "Omega PCT versioned particle snapshot",
  "type": "object",
  "required": ["edition", "cutoff_date", "source_locator", "source_sha256", "record_count", "accepted_count", "quarantine_count"],
  "properties": {
    "edition": {"type": "string", "minLength": 1},
    "cutoff_date": {"type": "string", "format": "date"},
    "source_locator": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "record_count": {"type": "integer", "minimum": 0},
    "accepted_count": {"type": "integer", "minimum": 0},
    "quarantine_count": {"type": "integer", "minimum": 0},
    "schema_version": {"const": "omega-pct-pdg-snapshot-0.3"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/omega_code_dojo_resolution_receipt_v4.schema.json",
  "title": "Omega Code Dojo R0.4 Resolution Receipt Summary",
  "type": "object",
  "required": [
    "campaign_id", "system_version", "logical_problem_space", "materialized_problems",
    "solved_problems", "unresolved_problems", "solve_rate", "total_attempts",
    "total_cost_units", "family_metrics", "claims", "receipt_sha256"
  ],
  "properties": {
    "campaign_id": {"type": "string", "minLength": 1},
    "system_version": {"const": "R0.4"},
    "logical_problem_space": {"type": "integer", "minimum": 1},
    "materialized_problems": {"type": "integer", "minimum": 0},
    "solved_problems": {"type": "integer", "minimum": 0},
    "unresolved_problems": {"type": "integer", "minimum": 0},
    "solve_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "total_attempts": {"type": "integer", "minimum": 0},
    "total_cost_units": {"type": "integer", "minimum": 0},
    "permanent_total_cap": {"type": ["integer", "null"], "minimum": 1},
    "family_metrics": {"type": "array", "minItems": 1},
    "claims": {"type": "object"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}

{
  "schema": "tristan-capability-manifest/0.3",
  "system": {
    "id": "omega-ai-tristan-lab",
    "version": "1.0.0",
    "distribution": "omega-ai-tristan-lab",
    "entrypoint_group": "tristan.plugins"
  },
  "capabilities": [
    {
      "id": "tristan.idea.analyze",
      "task": "idea-report",
      "input_kind": "idea",
      "output_kind": "analysis-report",
      "input_schema": "tristan.idea.v1",
      "output_schema": "tristan.analysis-report.v1",
      "permissions": ["PURE"],
      "deterministic": true,
      "oak_status": "TESTED"
    }
  ],
  "fabric": {
    "schema_graph": true,
    "pipeline_compiler": true,
    "structural_peer_contracts": true,
    "discovery_negative_memory": true,
    "distribution_provenance": true,
    "subprocess_sandbox": "USER_SPACE_BOUNDED",
    "supply_chain_inventory": true,
    "environment_matrix": true
  },
  "integration": {
    "latest_lock": "tristan-integration-lock-0.2",
    "latest_environment": "tristan-runtime-four-repo-r02",
    "latest_status": "CI_VERIFIED_FOUR_REPO_R02",
    "bundle_plan": "tristan-runtime-bundle-plan-1.0",
    "v10_typed_receipt_policy": {
      "schema": "tristan-private-wheelhouse-receipt-1.0",
      "status": "EXTERNAL_EXACT_RECEIPT_REQUIRED",
      "marker": "TRISTAN_V10_FULL_TYPED_FOUR_REPO_OFFLINE_PASS",
      "critical_path_wildcard_free": true,
      "offline_install_required": true,
      "receipt_must_pin_runtime_head": true,
      "receipt_must_pin_peer_heads": true,
      "receipt_must_verify_wheel_hashes": true,
      "reason": "Exact runtime head and artifact digest live in the external CI receipt to avoid self-referential manifest invalidation."
    }
  },
  "runtime": {
    "python": ">=3.10",
    "network_default": false,
    "automatic_install": false,
    "automatic_publish": false
  },
  "oak": {
    "generated_adapters_execute_by_default": false,
    "scientific_proof_implied_by_execution": false,
    "cross_domain_pipeline_inference": false,
    "negative_memory_required": true,
    "silent_plugin_discovery_failure_in_oak_strict": false,
    "declared_platform_target_implies_verified": false,
    "sandbox_is_certified_security_boundary": false,
    "peer_mapping_specs_require_runtime_normalization": true,
    "legacy_wildcards_permitted_outside_v10_critical_path": true,
    "public_bundle_redacts_private_peer_topology": true,
    "manifest_embeds_its_own_artifact_digest": false
  }
}

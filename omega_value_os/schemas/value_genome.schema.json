{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tristan.example/schemas/value_genome.schema.json",
  "title": "Omega ValueGenome",
  "type": "object",
  "additionalProperties": false,
  "required": ["need", "capability", "beneficiary", "transformation", "revenue_mode"],
  "properties": {
    "need": {"type": "string", "minLength": 1},
    "capability": {"type": "string", "minLength": 1},
    "beneficiary": {"type": "string", "minLength": 1},
    "transformation": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"type": "string"}, "default": []},
    "assets": {"type": "array", "items": {"type": "string"}, "default": []},
    "channels": {"type": "array", "items": {"type": "string"}, "default": []},
    "revenue_mode": {"enum": ["active", "passive", "mixed"]},
    "risks": {"type": "array", "items": {"type": "string"}, "default": []}
  }
}
